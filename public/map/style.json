{
  "version": 8,
  "name": "juanderquest-light",
  "metadata": {
    "openmaptiles:version": "3.x"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["/vt/{z}/{x}/{y}.mvt"],
      "maxzoom": 15,
      "attribution": "<a href=\"https://openmaptiles.org/\" target=\"_blank\">&copy; OpenMapTiles</a> <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">&copy; OpenStreetMap contributors</a> &middot; Boundaries: PSA / NAMRIA (indicative)"
    }
  },
  "glyphs": "/map/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F7EBE1"
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["all", ["==", "class", "wood"]],
      "paint": {
        "fill-color": "#C1ECD4",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["all", ["==", "class", "grass"]],
      "paint": {
        "fill-color": "#C1ECD4",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#7AA28D",
        "fill-opacity": 0.35
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["all", ["in", "class", "residential", "suburb", "neighbourhood"]],
      "paint": {
        "fill-color": "#FAF9F5",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#DBEAFE"
      }
    },
    {
      "id": "water_shoreline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "line-color": "#77A0F4",
        "line-width": 1.5
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#77A0F4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 14, 3]
      }
    },
    {
      "id": "road_minor_case",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "minor", "service", "track", "path"]],
      "paint": {
        "line-color": "#C49C6E",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.8, 16, 4.5]
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "minor", "service", "track", "path"]],
      "paint": {
        "line-color": "#FAF9F5",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 16, 2.5]
      }
    },
    {
      "id": "road_secondary_tertiary_case",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "secondary", "tertiary"]],
      "paint": {
        "line-color": "#7B4B27",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.6, 16, 7]
      }
    },
    {
      "id": "road_secondary_tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "secondary", "tertiary"]],
      "paint": {
        "line-color": "#FFF8E1",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 16, 4.5]
      }
    },
    {
      "id": "road_primary_case",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "primary"]],
      "paint": {
        "line-color": "#582F0E",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 2, 16, 8.5]
      }
    },
    {
      "id": "road_primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["==", "class", "primary"]],
      "paint": {
        "line-color": "#FFDEA9",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1, 16, 6]
      }
    },
    {
      "id": "road_motorway_case",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "motorway", "trunk"]],
      "paint": {
        "line-color": "#3E1F0A",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 2.2, 16, 9.5]
      }
    },
    {
      "id": "road_motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "motorway", "trunk"]],
      "paint": {
        "line-color": "#FFB703",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.2, 16, 7]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#C49C6E",
        "fill-outline-color": "#7B4B27",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "boundary_province",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 4]],
      "paint": {
        "line-color": "#582F0E",
        "line-width": 1.8,
        "line-dasharray": [3, 2],
        "line-opacity": 0.65
      }
    },
    {
      "id": "road_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#3E1F0A",
        "text-halo-color": "#FAF9F5",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "water_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#1B4965",
        "text-halo-color": "#FAF9F5",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "country_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", ["==", "$type", "Point"], ["==", "class", "country"]],
      "layout": {
        "text-field": "{name:latin}",
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 1, 10, 6, 16],
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#3E1F0A",
        "text-halo-color": "#FFF8E1",
        "text-halo-width": 2
      }
    }
  ]
}